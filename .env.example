# OAuth-токен Яндекс ID со скоупом webmaster:hostinfo.
# Как получить — см. README.md, раздел «Получение OAuth-токена».
# Значение сюда НЕ вписывать: этот файл лежит в git, а .env — нет.
YANDEX_WEBMASTER_OAUTH_TOKEN=

# Сайт по умолчанию. Пока он задан, host_id можно не передавать в каждый
# вызов: сервер при старте резолвит его через список сайтов аккаунта.
YANDEX_WEBMASTER_HOST_URL=https://samuiguide.ru
